<?xml version="1.0" encoding="utf-8"?>
<!-- Only in the Life Archipelago app (not the quest): deep links, app shortcuts, the widget and the tile. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name=".MainActivity" android:exported="true">
            <!-- R21: lifearchipelago://add?text=…, ://open?id=…, ://today, ://scan, ://voice -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lifearchipelago" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- R38: home-screen widget with today's tasks -->
        <receiver android:name=".TodayWidget" android:exported="true" android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.lifearchipelago.app.UPDATE_WIDGET" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/today_widget_info" />
        </receiver>

        <!-- R38: quick-settings tile "Add to Life" -->
        <service android:name=".CaptureTile" android:exported="true" android:label="@string/tile_label"
            android:icon="@drawable/ic_tile" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
